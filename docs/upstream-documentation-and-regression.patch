+// Synthetic coupled-RC regression: simultaneous current peaks do not bound droop.
+use vyges_em_ir::{emir::analyze, pdn::PdnSpec};
+
+#[test]
+fn staggered_switches_can_exceed_simultaneous_droop() {
+    let peak = |second_center: f64| {
+        let input = format!(
+            "vdd 1.8\npad p\nres p n1 1.0 met1\nres p n2 1.0 met1\n\
+             res n1 n2 1.0 met1\ncap n1 1000\ncap n2 1000\n\
+             switch n1 90.0 1.0 0.1\nswitch n2 90.0 {second_center} 0.1\n"
+        );
+        analyze(&PdnSpec::parse(&input).unwrap())
+            .unwrap().dynamic.unwrap().drop
+    };
+    let aligned = peak(1.0);
+    let staggered = peak(1.1);
+    assert!((aligned - 0.04758270548561106).abs() < 1e-6);
+    assert!((staggered - 0.05085767511973941).abs() < 1e-6);
+    assert!(staggered > aligned * 1.06);
+    // Illustrative model threshold; this is not a foundry sign-off limit.
+    assert!(aligned < 0.0495 && staggered > 0.0495);
+}
